# =====================================================================
# megadaemon.env — EJEMPLO. Copia a /data/local/tmp/megadaemon.env,
# rellena tus claves y haz `chmod 600`. NUNCA subas este fichero con
# valores reales a GitHub (está en .gitignore).
# =====================================================================

# --- Endpoint local del cockpit ------------------------------------------
MEGADAEMON_LISTEN=127.0.0.1:9090
MEGADAEMON_STATE_DIR=/data/local/tmp/megadaemon/state

# --- API key para acceso remoto (Fase 4) ---------------------------------
# Se genera con:  openssl rand -hex 32
# Formato: mdaemon_sk_live_<64 hex>
# Si se define, el cockpit EXIGE esta key para cualquier petición que no
# venga de loopback (127.0.0.1 / ::1).  Cabeceras admitidas:
#   X-API-Key: <key>      o      Authorization: Bearer <key>
# Sin key -> 401 | key incorrecta -> 403 | exceso de ritmo -> 429 (60/min)
MEGADAEMON_API_KEY=mdaemon_sk_live_PON_AQUI_LA_KEY_REAL

# --- Token de la sesión local (se genera solo en <STATE_DIR>/cockpit_token)
# La UI web lo recibe embebido en window.MEGADAEMON_TOKEN.

# --- Proveedores de nube (opcional) --------------------------------------
# Se guardan aparte en el cofre de claves; aquí sólo la URL base.
#MEGADAEMON_GROQ_BASE=https://api.groq.com/openai/v1
#MEGADAEMON_OLLAMA_BASE=http://127.0.0.1:11434
